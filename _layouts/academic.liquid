<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% capture full_name %}{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}{% endcapture %}
    <title>
      {% unless page.permalink == '/' %}{{ page.title | capitalize }} · {% endunless %}
      {{ full_name | strip | escape }}
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <meta name="theme-color" content="#faf9f6">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ full_name | strip | escape }} · HCI Research">
    <meta property="og:description" content="{{ page.description | default: site.description | strip_html | strip | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ '/assets/img/profile.jpg' | absolute_url }}">
    <meta name="twitter:card" content="summary">
    <link rel="icon" href="{{ '/assets/img/academic-mark.svg' | relative_url }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ '/assets/css/academic.css' | relative_url }}">
    <script defer src="{{ '/assets/js/academic.js' | relative_url }}"></script>
  </head>
  <body class="academic-site {% if page.permalink == '/' %}home-page{% endif %}">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="wordmark" href="{{ '/' | relative_url }}" aria-label="Charlie Zou, home"
          ><span class="monogram" aria-hidden="true">JZ<span>.</span></span
          ><span>Charlie Zou</span></a
        >
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" hidden>
          Menu <span aria-hidden="true">+</span>
        </button>
        <nav id="primary-navigation" class="primary-navigation" aria-label="Main navigation">
          <a href="{{ '/#about' | relative_url }}">About</a>
          <a href="{{ '/#research' | relative_url }}">Research</a>
          <a
            href="{{ '/publications/' | relative_url }}"
            {% if page.permalink == '/publications/' %}
              aria-current="page"
            {% endif %}
            >Publications</a
          >
          <a
            href="{{ '/cv/' | relative_url }}"
            {% if page.permalink == '/cv/' %}
              aria-current="page"
            {% endif %}
            >CV</a
          >
          <a class="nav-contact" href="mailto:{{ site.data.socials.email }}">Get in touch <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main-content" class="site-main" tabindex="-1">{{ content }}</main>
    <footer class="site-footer">
      <div>
        <a class="footer-name" href="{{ '/' | relative_url }}">Jiatuo “Charlie” Zou</a>
        <p>Human–Computer Interaction · Evanston, IL</p>
      </div>
      <div class="footer-links">
        <a href="mailto:{{ site.data.socials.email }}">Email ↗</a
        ><a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Scholar ↗</a
        ><a href="https://github.com/{{ site.data.socials.github_username }}">GitHub ↗</a>
      </div>
      <p class="colophon">
        Built with <a href="https://jekyllrb.com/">Jekyll</a> &amp; <a href="https://github.com/al-org-dev/al-folio">al-folio</a>.
      </p>
    </footer>
    <dialog class="research-video-dialog" aria-labelledby="research-video-title">
      <div class="video-dialog-header">
        <h2 id="research-video-title">Research preview</h2>
        <button type="button" class="video-close" aria-label="Close video">×</button>
      </div>
      <video controls playsinline preload="none"></video>
      <p>Research demonstration video. <a class="video-direct-link" href="#">Open video directly ↗</a></p>
    </dialog>
  </body>
</html>
