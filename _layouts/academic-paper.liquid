<article class="paper" id="paper-{{ entry.key }}" data-research="{{ entry.research | escape }}">
  <div class="paper-image">
    {% if entry.preview %}
      {% if entry.video -%}
        <a
          class="video-trigger"
          href="{{ entry.video | relative_url }}"
          data-research-video
          data-video-title="{{ entry.title | escape }}"
          aria-label="Play video for {{ entry.title | escape }}"
        >
      {%- endif %}
      <img
        src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}"
        alt="{{ entry.preview_alt | default: entry.title | escape }}"
        loading="lazy"
        width="400"
        height="250"
      >
      {% if entry.video -%}
        <span class="paper-play" aria-hidden="true">▶</span></a>
      {%- endif %}
    {% endif %}
  </div>
  <div class="paper-copy">
    <div class="paper-meta">
      <span class="venue-badge {% if entry.abbr == 'Under review' %}under-review{% endif %}">{{ entry.abbr }}</span><span>{{ entry.year }}</span>
      {%- if entry.research_label -%}
        <span>{{ entry.research_label }}</span>
      {%- endif %}
    </div>
    <h3>{{ entry.title }}</h3>
    <p class="paper-authors">
      {% assign authors = entry.author | split: ' and ' %}
      {% for author in authors %}
        {% assign parts = author | split: ', ' %}
        {% if author contains 'Zou' %}<strong>{% endif -%}
        {{- parts.last }}
        {{ parts.first -}}
        {%- if author contains 'Zou' %}</strong>{% endif -%}
        {%- unless forloop.last %}, {% endunless %}
      {% endfor %}
    </p>
    <p class="paper-venue">
      {{ entry.booktitle -}}
      {%- if entry.additional_info %} · {{ entry.additional_info }}{% endif %}
    </p>
    {% if entry.annotation %}
      <p class="paper-annotation">{{ entry.annotation }}</p>
    {% endif %}
    <div class="paper-links">
      {% if entry.pdf %}
        {% assign pdf_prefix = entry.pdf | slice: 0, 1 %}
        {% if entry.pdf contains '://' -%}
          {%- assign pdf_url = entry.pdf -%}
        {%- elsif pdf_prefix == '/' -%}
          {%- assign pdf_url = entry.pdf | relative_url -%}
        {%- else -%}
          {%- assign pdf_url = entry.pdf | prepend: '/assets/pdf/' | relative_url -%}
        {%- endif %}
        <a href="{{ pdf_url }}">Paper <span aria-hidden="true">↗</span></a>
      {% endif %}
      {% if entry.arxiv -%}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.doi -%}
        <a href="https://doi.org/{{ entry.doi }}">DOI <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.poster -%}
        <a href="{{ entry.poster | prepend: '/assets/pdf/' | relative_url }}">Poster <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.code -%}
        <a href="{{ entry.code }}">Code <span aria-hidden="true">↗</span></a>
      {%- endif %}
      {% if entry.video -%}
        <a href="{{ entry.video | relative_url }}" data-research-video data-video-title="{{ entry.title | escape }}"
          >Video <span aria-hidden="true">▷</span></a
        >
      {%- endif %}
    </div>
    {% if entry.abstract %}
      <details class="paper-abstract">
        <summary>Read abstract</summary>
        <p>{{ entry.abstract }}</p>
      </details>
    {% endif %}
  </div>
</article>
