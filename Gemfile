source "https://rubygems.org"

# AcadHomepage's documented native Jekyll option. Jekyll 3 retains the
# template's Sass/Susy compatibility and loads the local bibliography adapter.
gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm", "~> 1.1"
gem "jekyll-sitemap", "~> 1.4", group: :jekyll_plugins
gem "jekyll-redirect-from", "~> 0.16", group: :jekyll_plugins

# Keep the user's bibliography as the publication source of truth.
gem "bibtex-ruby", "~> 6.2"
gem "webrick", "~> 1.9"
gem "wdm", "~> 0.1.0" if Gem.win_platform?
